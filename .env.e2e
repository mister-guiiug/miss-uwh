# Build E2E : on force le mode LOCAL (pas d'auth Supabase) pour tester le
# parcours hors-ligne (onboarding → lanceur). Chargé par `vite build --mode e2e`
# (cf. playwright.config.ts), il prime sur .env / .env.production.
VITE_BACKEND=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Identifiant de mesure FACTICE, pour que la garde de l'écran d'entrée ait
# quelque chose à vérifier : sans lui, `ConsentBanner` ne rend rien et la vue
# de page ne peut pas partir. Le trafic vers Google est intercepté par la
# garde elle-même — rien ne sort, et aucune propriété réelle n'est touchée.
VITE_POSTHOG_KEY=phc_e2e0000000000000000000000
